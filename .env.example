# Copy to .env and replace EVERY placeholder. Never commit .env.
# "demo" or "production"
APP_MODE=demo
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@db:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app
# e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_long_random_string
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_fernet_key
ACCESS_TOKEN_MINUTES=30
# add your Vercel URL, comma-separated
CORS_ORIGINS=http://localhost:3000
# first login, created only if no user exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
# leave empty for AWS S3
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=videos
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME_local_only
MINIO_ROOT_PASSWORD=CHANGE_ME_local_only_8chars
